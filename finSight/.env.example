# FinSight Environment Configuration
PORT=5000
MONGO_URI=mongodb://localhost:27017/finsight
JWT_SECRET=your_jwt_secret_key_here
CLIENT_URL=http://localhost:5173

# Optional LLM API keys for Natural Language Quick Add (Phase 1)
# FinSight includes a deterministic heuristic parser that works out-of-the-box if omitted.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional AWS Textract credentials for Receipt Scanning (Phase 1, Step 5)
# If omitted, FinSight uses multimodal AI / simulated preview mode gracefully.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
