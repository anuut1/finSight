# FinSight Environment Configuration
PORT=5000
MONGO_URI=mongodb://localhost:27017/finsight
JWT_SECRET=your_jwt_secret_key_here
CLIENT_URL=http://localhost:5173

# Optional LLM API keys for Natural Language Quick Add (Phase 1)
# FinSight includes a deterministic heuristic parser that works out-of-the-box if omitted.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional AWS credentials for Textract Receipt Scanning, SES Email Digest, and SNS Alerts
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# AWS SES / SNS End-of-Day Reminders (Phase 1, Step 6)
AWS_SES_FROM_EMAIL=
AWS_SNS_TOPIC_ARN=
REMINDER_SECRET_KEY=your_secure_eod_cron_secret
API_BASE_URL=http://localhost:5000
