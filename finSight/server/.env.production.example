# ========================================================
# FinSight Backend - Production Environment Template (AWS)
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL=https://app.yourdomain.com

# Database Connection (MongoDB Atlas on AWS or Amazon DocumentDB)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/finsight?retryWrites=true&w=majority

# Authentication Secret (Generate with: openssl rand -hex 32)
JWT_SECRET=generate_a_64_character_hex_secret_here

# AWS Region (e.g. ap-south-1 Mumbai, us-east-1 N. Virginia)
AWS_REGION=ap-south-1

# S3 Private Bucket for Receipts (Lifecycle: 30 days)
AWS_RECEIPTS_BUCKET=finsight-receipts-private-prod

# Amazon SES (Simple Email Service)
AWS_SES_FROM_EMAIL=notifications@yourdomain.com

# Optional SNS Topic ARN for SMS alerts
# AWS_SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:FinSightAlerts

# Shared Secret for authenticating scheduled cron invocations (EventBridge -> Lambda)
REMINDER_SECRET_KEY=generate_a_secure_random_hex_string
